APP_NAME="AI Interactive Video"
DATA_DIR="./data"
FRONTEND_ORIGIN="http://localhost:5173"

# mock runs locally, including story planning, without API keys.
# Other adapters: veo_lite | veo_fast | veo_standard | veo | fal.
VIDEO_PROVIDER="mock"
GEMINI_API_KEY=""
FAL_KEY=""

# Model IDs are configurable examples. Check your provider's current catalog.
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FILE_POLL_INTERVAL_SECONDS=5
GEMINI_FILE_PROCESSING_TIMEOUT_SECONDS=600
VEO_MODEL_ID="veo-3.1-lite-generate-preview"
VEO_LITE_MODEL_ID="veo-3.1-lite-generate-preview"
VEO_FAST_MODEL_ID="veo-3.1-fast-generate-preview"
VEO_STANDARD_MODEL_ID="veo-3.1-generate-preview"
VEO_DURATION_SECONDS=8
VEO_RESOLUTION="720p"
VEO_POLL_INTERVAL_SECONDS=10
VEO_TIMEOUT_SECONDS=900
VEO_MAX_RETRIES=2
VEO_RETRY_INITIAL_DELAY_SECONDS=60
VEO_RETRY_BACKOFF_MULTIPLIER=2.0

FAL_TEXT_MODEL_ID="bytedance/seedance-2.0/text-to-video"
FAL_REFERENCE_MODEL_ID="bytedance/seedance-2.0/reference-to-video"
FAL_START_TIMEOUT_SECONDS=300
FAL_CLIENT_TIMEOUT_SECONDS=1800

NODE_COUNT=5
# Requests override SEGMENTS_PER_NODE: ceil(clip length / segment duration).
SEGMENTS_PER_NODE=2
SEGMENT_SECONDS=8
VIDEO_RESOLUTION="720p"
VIDEO_ASPECT_RATIO="16:9"
GENERATE_AUDIO=true
REFERENCE_CLIP_SECONDS=10
USE_REFERENCE_FOR_ROOT_FIRST_SEGMENT=true
USE_REFERENCE_FOR_ALL_NODE_FIRST_SEGMENTS=false
FALLBACK_TO_TEXT_ON_REFERENCE_ERROR=true
